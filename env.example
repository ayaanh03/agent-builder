# Copy to .env and fill in your keys.
#   cp env.example .env

# OpenAI — used by the Agents SDK for LLM calls
OPENAI_API_KEY=

# Avis mock API
AVIS_API_KEY=
AVIS_API_URL=https://avis-mock-api-production.up.railway.app

# Set to "development" to include full data in OpenAI trace payloads.
# Defaults to "production" (PII stripped).
ENVIRONMENT=development
